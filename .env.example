# Generate a secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Channel ID and Channel secret from a Web app LINE Login channel.
AUTH_LINE_ID=
AUTH_LINE_SECRET=
# LINE Login channel in the same provider as the LINE OA. Keep original credentials to migrate accounts.
# Callback URL: /api/auth/callback/line-oa
P3D_LINE_OA_ID=
P3D_LINE_OA_SECRET=
# Comma-separated Google email addresses allowed to view incoming print orders.
P3D_ADMIN_EMAILS=

# Customer and admin URLs. Run the admin process separately using npm run start:admin.
P3D_CUSTOMER_URL=http://localhost:3000
P3D_ADMIN_URL=http://localhost:3001

# LINE Messaging API credentials for new order notifications on the customer server.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Use a LINE Messaging API user ID or group ID, rather than a LINE username.
LINE_ADMIN_RECIPIENT_ID=
# Optional: Turso (libSQL) cloud SQLite for Vercel deployment.
# Leave empty to use local .p3d-data/accounts.sqlite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

